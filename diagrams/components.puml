@startuml
top to bottom direction
actor "Programuotojas" as User
component "Colab sąsaja" as UI
component "Vienas peržiūros agentas\nįvestis, kontekstas, užklausa, validacija" as Agent
database "ChromaDB\n1200 pavyzdžių" as DB
component "MiniLM embedding modelis" as Embed
cloud "Gemini API\ngeneratyvinis modelis" as LLM
